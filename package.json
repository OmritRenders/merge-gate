  "bin": {
    "merge-gate": "./dist/src/install.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OmritRenders/merge-gate.git"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc",
    "check:dist": "node scripts/check-dist.mjs"
  },
  "devDependencies": {
    "@types/node": "^24.10.1",
    "typescript": "^5.9.3"
  }
}
